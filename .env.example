# Set to the final company website origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Public Storefront API; tokenless browsing and cart work on the current store.
SHOPIFY_STORE_DOMAIN=krtymq-v4.myshopify.com
# Optional public Storefront token (never use an Admin API token).
SHOPIFY_STOREFRONT_TOKEN=
# Temporary inventory bridge: keep the live theme stock metadata available.
SHOPIFY_INVENTORY_ORIGIN=https://lxpforged.com
# Enable only after the domain migration, inventory integration and SEO audit.
SHOP_SEO_LIVE=false
